# ---- Raw downloads: archived, never edited, never committed --------------
# Standing rule: a stranger holding only provenance/sources.csv can
# re-download every one of these. That is why they are not in the history.
data-raw/*
!data-raw/.gitkeep
# ...but keep each archive folder's hash manifest, so the history records what
# the bytes were even though it does not record the bytes.
!data-raw/*/
data-raw/*/*
!data-raw/*/MANIFEST.sha256

# ---- Built products: regenerated by make.R ------------------------------
data/*
!data/.gitkeep
# ...except the specification registry. It is a build product like the rest,
# but Task 3.5 requires it be committed BEFORE the spec curve is fitted -- the
# commit timestamp is the evidence the grid was frozen first. Force-tracked.
!data/spec-registry.rds
!data/spec-registry.csv
output/figures/*
!output/figures/.gitkeep
# ...but keep the final suite's hash manifest (Task 5.1), so the history records
# what each report figure's bytes were without committing the images.
!output/figures/final/
output/figures/final/*
!output/figures/final/MANIFEST.csv
output/tables/*
!output/tables/.gitkeep
output/models/*
!output/models/.gitkeep

# ---- renv: lockfile is tracked, the library is not ----------------------
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/

# ---- R / editor cruft ---------------------------------------------------
.Rhistory
.RData
.Rproj.user/
.Ruserdata
*.Rproj
.DS_Store

# ---- Archived states (Task S0.1): local copies, hash manifest tracked ------
archive/*/*
!archive/*/MANIFEST.csv

# ---- The built report (Task S0.3): regenerated by make.R --release -------
output/report/*
